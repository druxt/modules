{
  "schemaVersion": 1,
  "modules": [
    {
      "name": "auth",
      "repo": "druxt/druxt-auth",
      "category": "authentication",
      "status": "stable",
      "icon": "auth.svg",
      "drupal": [
        {
          "name": "simple_oauth",
          "label": "Simple OAuth",
          "setup": [
            {
              "title": "Generate the keys that sign the tokens, outside the web root",
              "command": "drush simple-oauth:generate-keys /absolute/path/to/keys",
              "url": "https://git.drupalcode.org/project/simple_oauth/-/blob/6.1.x/README.md"
            },
            {
              "title": "Save the paths to both keys at /admin/config/people/simple_oauth",
              "url": "https://git.drupalcode.org/project/simple_oauth/-/blob/6.1.x/README.md"
            },
            {
              "title": "Simple OAuth 6 only: create a scope with the Authorization code grant at /admin/config/people/simple_oauth/oauth2_scope/dynamic/add",
              "url": "https://github.com/druxt/druxt-auth#drupal"
            },
            {
              "title": "Create a consumer at /admin/config/services/consumer/add, and use its Client ID as clientId",
              "url": "https://github.com/druxt/druxt-auth#drupal"
            },
            {
              "title": "Authorization code grant only: give your users' role the Grant OAuth2 codes permission",
              "url": "https://github.com/druxt/druxt-auth#drupal"
            }
          ]
        }
      ],
      "options": [
        {
          "name": "clientId",
          "type": "string",
          "description": "The Client ID field of the Drupal consumer, not its UUID.",
          "required": true
        },
        {
          "name": "clientSecret",
          "type": "string",
          "description": "The secret of the Drupal consumer. The password grant sends it, and a public consumer needs none."
        },
        {
          "name": "passwordClientId",
          "type": "string",
          "description": "The consumer the password grant authenticates as, when it is not the one clientId names."
        },
        {
          "name": "passwordSession",
          "type": "boolean",
          "description": "Open a Drupal session beside the password grant, for a site that proxies Drupal's own pages.",
          "default": false
        },
        {
          "name": "scope",
          "type": "array",
          "description": "The OAuth scopes to request. Unset, no scope is sent and Simple OAuth 6 uses the consumer's own."
        }
      ],
      "type": "official",
      "archived": false,
      "description": "Authentication module for DruxtJS",
      "npm": "druxt-auth",
      "compatibility": {
        "druxt": "unknown"
      },
      "website": "https://github.com/druxt/druxt-auth"
    },
